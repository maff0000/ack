#!/usr/bin/env python3
from pathlib import Path
import argparse
import sys

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))

from ack.pl import bootstrap_project, launch, preflight, validate_project_root
from ack.redact import redact
from ack.runtime import load_startup_runtime


def main() -> int:
    parser = argparse.ArgumentParser(description="Launch Axiom from a PID-verified project root")
    parser.add_argument("action_or_root", help="project root, 'preflight', 'bootstrap', or 'resume'")
    parser.add_argument("root", nargs="?", help="absolute project root for the selected action")
    parser.add_argument("--config")
    args = parser.parse_args()
    try:
        if args.action_or_root in {"preflight", "bootstrap", "resume"}:
            if not args.root: parser.error(f"{args.action_or_root} requires an absolute project root")
            root = bootstrap_project(args.root) if args.action_or_root == "bootstrap" else validate_project_root(args.root)
            load_startup_runtime(root)
            resuming = args.action_or_root == "resume"
            ready, lines = preflight(root, args.config, allow_redis_degraded=resuming)
            print("\n".join(lines))
            if not ready: return 1
            if args.action_or_root == "bootstrap": return launch(root)
            if resuming: return launch(root, resume=True)
            return 0
        if args.root:
            parser.error("unexpected second project root")
        root = validate_project_root(args.action_or_root)
        load_startup_runtime(root)
        ready, lines = preflight(root, args.config)
        print("\n".join(lines))
        if not ready: return 1
        return launch(root)
    except Exception as exc:
        print(f"ACK PL ERROR: {redact(exc)}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
